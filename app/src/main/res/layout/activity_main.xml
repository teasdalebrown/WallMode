<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dashboard_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_wallmode_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/dashboard_fallback_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/dashboard_loading"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/recovery_on_bg_subtle" />

        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_primary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recovery_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/recovery_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/recovery_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/recovery_on_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recovery_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/recovery_on_bg" />

                <TextView
                    android:id="@+id/recovery_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/recovery_on_bg_subtle" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <io.github.rvbcrs.wallmode.AmbientScreensaverView
        android:id="@+id/ambient_screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/action_card_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E600080C"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="420dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/recovery_bg"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="20dp">

                <TextView
                    android:id="@+id/action_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="@color/recovery_on_bg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/action_card_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/recovery_on_bg_subtle" />

                <TextView
                    android:id="@+id/action_card_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_card_publish_failed"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/settings_amber"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_card_button_1"
                    style="@style/Widget.WallMode.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_card_button_2"
                    style="@style/Widget.WallMode.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_card_button_3"
                    style="@style/Widget.WallMode.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Hidden admin gesture zone: tap the configured corner 5 times to open settings. -->
    <View
        android:id="@+id/admin_tap_zone"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/admin_gesture_desc"
        android:focusable="false" />

</FrameLayout>
