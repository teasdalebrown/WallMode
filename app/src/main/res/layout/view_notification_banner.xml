<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    android:clickable="true"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/banner_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/banner_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/banner_dismiss"
            android:padding="12dp"
            android:src="@drawable/ic_banner_close"
            app:tint="@color/recovery_on_bg" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/banner_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/banner_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/recovery_on_bg"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/banner_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/recovery_on_bg_subtle"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/banner_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/banner_action_failed"
                android:textColor="#FFD089"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/banner_action"
        style="@style/Widget.WallMode.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="false"
        android:textColor="#07161B"
        app:cornerRadius="12dp"
        android:visibility="gone" />
</LinearLayout>
