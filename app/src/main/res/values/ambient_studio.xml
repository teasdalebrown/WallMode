<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="settings_page_padding">10dp</dimen>
    <dimen name="settings_card_padding">14dp</dimen>
    <dimen name="settings_section_gap">8dp</dimen>
    <dimen name="settings_topbar_min_height">64dp</dimen>
    <dimen name="settings_footer_min_height">56dp</dimen>
    <dimen name="ambient_background_tile_width">124dp</dimen>
    <dimen name="ambient_background_tile_height">112dp</dimen>

    <style name="Widget.WallMode.AmbientChoiceCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="checkedIcon">@drawable/ic_action_check</item>
        <item name="checkedIconTint">@color/white</item>
        <item name="checkedIconSize">20dp</item>
        <item name="checkedIconMargin">7dp</item>
        <item name="rippleColor">@color/brand_primary_faint</item>
    </style>

    <style name="Widget.WallMode.AmbientChoiceLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/brand_on_surface</item>
    </style>
</resources>
