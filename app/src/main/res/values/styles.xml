<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.WallMode.SectionCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.WallMode.SectionCard.Ambient">
        <item name="cardBackgroundColor">@color/settings_ambient_surface</item>
    </style>

    <style name="Widget.WallMode.SectionCard.Status">
        <item name="cardBackgroundColor">@color/settings_status_surface</item>
    </style>

    <style name="Widget.WallMode.SectionCard.Danger">
        <item name="cardBackgroundColor">@color/settings_danger_surface</item>
        <item name="strokeColor">@color/settings_danger_stroke</item>
    </style>

    <style name="Widget.WallMode.RailCard" parent="Widget.WallMode.SectionCard">
        <item name="cardBackgroundColor">@color/settings_rail_surface</item>
        <item name="strokeColor">@color/glass_card_stroke</item>
    </style>

    <style name="Widget.WallMode.TopBarCard" parent="Widget.WallMode.SectionCard">
        <item name="cardBackgroundColor">@color/settings_bar_surface</item>
    </style>

    <style name="Widget.WallMode.FooterCard" parent="Widget.WallMode.SectionCard">
        <item name="cardBackgroundColor">@color/settings_bar_surface</item>
        <item name="cardCornerRadius">18dp</item>
    </style>

    <style name="Widget.WallMode.DeviceChipCard" parent="Widget.WallMode.SectionCard">
        <item name="cardBackgroundColor">@color/settings_status_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/settings_status_stroke</item>
    </style>

    <style name="Widget.WallMode.StatusChipCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/settings_chip_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.WallMode.SettingsTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/card_stroke</item>
        <item name="boxBackgroundColor">@color/glass_input_surface</item>
    </style>

    <style name="Widget.WallMode.NavButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/tab_nav_text</item>
        <item name="backgroundTint">@color/settings_nav_background</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">@color/tab_nav_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/brand_primary_faint</item>
    </style>

    <style name="Widget.WallMode.SegmentedGroup" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.WallMode.SegmentedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/tab_nav_text</item>
        <item name="backgroundTint">@color/settings_nav_background</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <style name="Widget.WallMode.SettingSwitch" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.WallMode.CardEyebrow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.WallMode.CardEyebrow.Success">
        <item name="android:textColor">@color/settings_success</item>
    </style>

    <style name="Widget.WallMode.CardEyebrow.Amber">
        <item name="android:textColor">@color/settings_amber</item>
    </style>

    <style name="Widget.WallMode.CardEyebrow.Danger">
        <item name="android:textColor">@color/destructive</item>
    </style>

    <style name="Widget.WallMode.CardTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="android:textColor">@color/brand_on_surface</item>
    </style>

    <style name="Widget.WallMode.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
    </style>

    <style name="Widget.WallMode.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/brand_on_primary</item>
    </style>

    <style name="Widget.WallMode.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">@color/brand_primary_faint</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.WallMode.Button.GlassOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="strokeColor">@color/glass_card_stroke</item>
    </style>

    <style name="Widget.WallMode.Button.Danger" parent="Widget.WallMode.Button.GlassOutlined">
        <item name="android:textColor">@color/destructive</item>
        <item name="strokeColor">@color/settings_danger_stroke</item>
    </style>

    <style name="Widget.WallMode.ConfigActions" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Widget.WallMode.ConfigActions.Heading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.WallMode.ConfigActions.ButtonRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.WallMode.ConfigActions.Button" parent="Widget.WallMode.Button.GlassOutlined">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>
</resources>
